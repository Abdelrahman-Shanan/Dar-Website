@{
    ViewData["Title"] = "تعديل الشقة | DAR";
    ViewData["UserName"] = "أحمد الخطيب";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages.css" />
}
@section Scripts {
    <script src="~/js/pages.js" defer></script>
}

  <main class="container page">
    <ol class="crumbs" aria-label="مسار التنقل"><li><a href="@Url.Action("Index", "Home")">الرئيسية</a></li><li><a href="@Url.Action("MyListings", "Owner")">حساب المالك</a></li><li>تعديل الشقة</li></ol>
    <div class="page-head"><div><h1>تعديل الشقة</h1><p class="sub">شقة مفروشة بالقرب من الجامعة الأردنية · الإعلان رقم ٢٤١ · منشورة ومتاحة</p></div><div class="head-side"><a class="btn btn-outline" href="@Url.Action("Details", "Properties")">عرض الإعلان <svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 17 7 7M7 15V7h8"/></svg></a></div></div>
    <div class="dash"><aside class="side" aria-label="قائمة الحساب"><div class="side-user"><span class="avatar"><svg class="ic ic-lg" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><strong>أحمد الخطيب</strong><span>حساب المالك · رقم هاتف موثّق</span></div><nav class="side-nav"><a href="@Url.Action("MyListings", "Owner")" class="active" aria-current="page"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"/></svg><span>شققي</span><span class="count">٤</span></a><a href="@Url.Action("AddListing", "Owner")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg><span>إضافة شقة</span></a><a href="@Url.Action("IncomingRequests", "Owner")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 13h5l1 3h6l1-3h5"/><path d="M5 5h14l2 8v6H3v-6z"/></svg><span>الطلبات الواردة</span><span class="count">٢</span></a><a href="@Url.Action("Profile", "Owner")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>الملف الشخصي</span></a></nav><a class="side-logout" href="@Url.Action("Login", "Account")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4"/><path d="m16 8 4 4-4 4M20 12H9"/></svg><span>تسجيل الخروج</span></a><div class="side-help"><strong>تحتاج مساعدة؟</strong><p>فريق dar معك في كل خطوة.</p><a href="#footer">تواصل مع الدعم ←</a></div></aside><div class="dash-main"><form data-demo-form="تم التحقق من التعديلات. إرسالها للمراجعة يحتاج إلى Backend." novalidate><div class="notice"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg><span>التعديلات على بيانات السكن والصور تُراجع قبل نشرها. يبقى إعلانك الحالي ظاهرًا حتى اعتماد التحديث.</span></div><nav class="form-steps" aria-label="أقسام النموذج"><a class="active" href="#basic">المعلومات الأساسية</a><a href="#cost">التفاصيل والتكلفة</a><a href="#rules">المرافق والقواعد</a><a href="#photos">الصور والمراجعة</a></nav><section class="panel form-section" id="basic"><h2>المعلومات الأساسية</h2><p class="sub">الحقول المعلّمة بنجمة (*) مطلوبة.</p>
      <div class="fgrid">
        <div class="f full"><label for="title">عنوان الإعلان *</label><input id="title" name="title" type="text" value="شقة مفروشة بالقرب من الجامعة الأردنية" placeholder="مثال: شقة مفروشة قريبة من الجامعة" required maxlength="150"><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="type">نوع السكن *</label><select id="type" name="type" required><option value="">اختر نوع السكن</option><option value="apartment" selected>شقة كاملة</option><option value="studio">استوديو</option><option value="private_room">غرفة خاصة</option><option value="shared_room">غرفة مشتركة</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="target_group">مناسب لـ *</label><select id="target_group" name="target_group" required><option value="">اختر الفئة المناسبة</option><option value="all_students" selected>الطلاب الجامعيين</option><option value="female_only">الطالبات فقط</option><option value="male_only">الطلاب فقط</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="city">المدينة *</label><select id="city" name="city" required><option value="">اختر المدينة</option><option value="عمّان" selected>عمّان</option><option value="إربد">إربد</option><option value="الزرقاء">الزرقاء</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="area">المنطقة / الحي *</label><select id="area" name="area" required><option value="">اختر المنطقة</option><option value="الجبيهة" selected>الجبيهة</option><option value="ضاحية الرشيد">ضاحية الرشيد</option><option value="تلاع العلي">تلاع العلي</option><option value="أبو نصير">أبو نصير</option><option value="شارع ياجوز">شارع ياجوز</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f full"><label for="street">العنوان التفصيلي *</label><input id="street" name="street" required maxlength="200" value="شارع الجامعة، بالقرب من البوابة الشمالية، الطابق الثاني" placeholder="اسم الشارع، أقرب معلم، ورقم المبنى"><span class="hint">لا نعرض رقم المبنى للعامة حفاظًا على خصوصية الساكنين.</span><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="university_id">الجامعة الأقرب *</label><select id="university_id" name="university_id" required><option value="">اختر الجامعة</option><option value="1" selected>الجامعة الأردنية</option><option value="2">جامعة العلوم التطبيقية</option><option value="3">جامعة الأميرة سمية</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="distance_minutes">المسافة إلى الجامعة (بالدقائق) *</label><div class="fgrid" style="gap:10px"><input id="distance_minutes" name="distance_minutes" type="number" min="1" max="120" required inputmode="numeric" value="8" placeholder="مثال: ١٠"><select id="transport_mode" name="transport_mode" aria-label="وسيلة الوصول"><option value="walk" selected>مشيًا</option><option value="bus">بالحافلة</option></select></div><span class="err">أدخل المسافة بالدقائق.</span></div>
        <div class="f full"><label for="description">وصف السكن *</label><textarea id="description" name="description" required maxlength="2000" minlength="50" data-count="#desc-count" placeholder="صف المساحة، الأثاث، الإضاءة، الموقع والخدمات القريبة...">شقة مريحة ومفروشة بالكامل في الجبيهة، على بُعد ٨ دقائق مشيًا من البوابة الشمالية للجامعة الأردنية. تضم غرفتي نوم وصالة جلوس ومطبخًا مجهزًا، مع إضاءة طبيعية ومساحة مناسبة للدراسة. مناسبة لطالبين يبحثان عن سكن هادئ وقريب من المحاضرات والخدمات. تقع في الطابق الثاني، بالقرب من محلات البقالة والمواصلات.</textarea><div class="hint-row"><span class="hint">اكتب وصفًا واضحًا من ٥٠ إلى ٢٠٠٠ حرف.</span><span class="hint" id="desc-count"></span></div><span class="err">اكتب وصفًا للسكن (٥٠ حرفًا على الأقل).</span></div>
      </div></section><section class="panel form-section" id="details"><h2>تفاصيل السكن</h2><p class="sub">مواصفات دقيقة تساعد الطلاب على اختيار المكان المناسب.</p>
      <div class="fgrid">
        <div class="f"><label for="area_m2">المساحة (م²) *</label><input id="area_m2" name="area_m2" type="text" value="٨٥" placeholder="مثال: ٨٠" required inputmode="decimal"><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="floor">الطابق *</label><select id="floor" name="floor" required><option value="">اختر الطابق</option><option value="0">الأرضي</option><option value="1">الأول</option><option value="2" selected>الثاني</option><option value="3">الثالث</option><option value="4">الرابع أو أعلى</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="bedrooms">عدد غرف النوم *</label><select id="bedrooms" name="bedrooms" required><option value="">اختر العدد</option><option value="1">١</option><option value="2" selected>٢</option><option value="3">٣</option><option value="4">٤ أو أكثر</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="bathrooms">عدد الحمّامات *</label><select id="bathrooms" name="bathrooms" required><option value="">اختر العدد</option><option value="1" selected>١</option><option value="2">٢</option><option value="3">٣</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="capacity">الحد الأقصى للساكنين *</label><input id="capacity" name="capacity" type="number" value="٢" placeholder="عدد الأشخاص" required min="1" inputmode="numeric"><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="furnishing">حالة التأثيث *</label><select id="furnishing" name="furnishing" required><option value="">اختر حالة التأثيث</option><option value="full" selected>مفروشة بالكامل</option><option value="partial">مفروشة جزئيًا</option><option value="none">غير مفروشة</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f full"><label class="chk"><input type="checkbox" name="shared_bathroom" value="1"><span>الحمّام مشترك مع ساكنين آخرين</span></label></div>
      </div></section>
    <section class="panel form-section" id="cost"><h2>الإيجار والتوفر</h2><p class="sub">جميع المبالغ بالدينار الأردني، مع توضيح الرسوم الإضافية.</p>
      <div class="fgrid">
        <div class="f"><label for="price">الإيجار الشهري (د.أ) *</label><input id="price" name="price" type="number" value="٢٨٠" placeholder="مثال: ٢٨٠" required min="1" step="0.5" inputmode="decimal"><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="deposit">التأمين المسترد (د.أ) *</label><input id="deposit" name="deposit" type="number" value="٢٨٠" placeholder="مثال: ٢٨٠" required min="0" step="0.5" inputmode="decimal"><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="min_rental_months">الحد الأدنى لمدة الإيجار *</label><select id="min_rental_months" name="min_rental_months" required><option value="">اختر مدة العقد</option><option value="4" selected>فصل دراسي</option><option value="9">سنة دراسية</option><option value="3">٣ أشهر</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="avail_mode">متاحة من *</label><select id="avail_mode" name="avail_mode" required><option value="now" selected>متاحة للإيجار الآن</option><option value="date">من تاريخ محدد</option></select><input id="available_from" name="available_from" type="date" hidden aria-label="تاريخ التوفر" style="margin-top:8px"></div>
        <div class="f"><label for="utilities_included">الماء والكهرباء *</label><select id="utilities_included" name="utilities_included" required><option value="">اختر آلية الفواتير</option><option value="0" selected>حسب الاستهلاك · غير مشمولة</option><option value="1">مشمولة في الإيجار</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="internet">الإنترنت *</label><select id="internet" name="internet" required><option value="">اختر حالة الإنترنت</option><option value="available" selected>متوفر · غير مشمول</option><option value="included">متوفر ومشمول</option><option value="none">غير متوفر</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f full"><label for="extra_cost_note">تفاصيل التكلفة الإضافية</label><input id="extra_cost_note" name="extra_cost_note" type="text" value="الإيجار للشقة كاملة، مناسب لطالبين. الماء والكهرباء حسب الاستهلاك." placeholder="وضّح أي رسوم خدمات أو تكاليف إضافية" maxlength="500"><span class="err">هذا الحقل مطلوب.</span></div>
      </div></section><section class="panel form-section" id="rules"><h2>المرافق المتوفرة</h2><p class="sub">اختر المرافق الموجودة فعلًا في السكن. ويمكنك اختيار أكثر من مرفق.</p><div class="chk-grid"><label class="chk"><input type="checkbox" name="amenities" value="1" checked><span>إنترنت متوفر</span></label><label class="chk"><input type="checkbox" name="amenities" value="2" checked><span>مكاتب للدراسة</span></label><label class="chk"><input type="checkbox" name="amenities" value="3" checked><span>مطبخ مجهّز</span></label><label class="chk dim"><input type="checkbox" name="amenities" value="4"><span>تدفئة وتكييف</span></label><label class="chk"><input type="checkbox" name="amenities" value="5" checked><span>غسالة ملابس</span></label><label class="chk"><input type="checkbox" name="amenities" value="6" checked><span>قريبة من المواصلات</span></label><label class="chk"><input type="checkbox" name="amenities" value="7" checked><span>شرفة وإضاءة طبيعية</span></label><label class="chk dim"><input type="checkbox" name="amenities" value="8"><span>موقف سيارات</span></label></div></section>
    <section class="panel"><h2>قواعد وشروط الإقامة</h2><p class="sub">وضّح القواعد قبل إرسال الطلاب لطلباتهم.</p>
      <div class="fgrid">
        <div class="f"><label for="smoking_allowed">التدخين داخل السكن</label><select id="smoking_allowed" name="smoking_allowed"><option value="">اختر السياسة</option><option value="0" selected>غير مسموح</option><option value="1">مسموح</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f"><label for="pets_allowed">الحيوانات الأليفة</label><select id="pets_allowed" name="pets_allowed"><option value="">اختر السياسة</option><option value="0" selected>غير مسموح</option><option value="1">مسموح</option></select><span class="err">هذا الحقل مطلوب.</span></div>
        <div class="f full"><label for="rules_text">شروط الإقامة *</label><textarea id="rules_text" name="rules" required maxlength="2000" placeholder="اكتب شروط العقد، أوقات الهدوء، وقواعد المحافظة على السكن...">مخصصة للطلاب الجامعيين، بحد أقصى شخصين.
مدة العقد فصل دراسي على الأقل، والتأمين مسترد حسب حالة الشقة.
يُرجى الالتزام بالهدوء والمحافظة على المرافق المشتركة.</textarea><span class="err">اكتب شروط الإقامة.</span></div>
      </div></section><section class="panel form-section" id="photos"><h2>صور السكن</h2><p class="sub">أضف من ٤ إلى ٨ صور واضحة تشمل الغرف والمطبخ والحمّامات.</p>
      <div class="photo-head"><span id="photo-count"></span><span class="badge b-info" style="font-weight:600">الصورة الأولى هي الغلاف</span></div><div class="photo-grid" id="photo-grid"><figure class="ph" style="margin:0"><img src="~/assets/p-apartment.jpg" alt="واجهة المبنى"><div class="ph-foot"><span>صورة الغلاف</span><button type="button">إزالة</button></div></figure><figure class="ph" style="margin:0"><img src="~/assets/g-living.jpg" alt="غرفة الجلوس"><div class="ph-foot"><span>صورة السكن</span><button type="button">إزالة</button></div></figure><figure class="ph" style="margin:0"><img src="~/assets/g-bedroom.jpg" alt="غرفة النوم"><div class="ph-foot"><span>صورة السكن</span><button type="button">إزالة</button></div></figure><figure class="ph" style="margin:0"><img src="~/assets/g-kitchen.jpg" alt="المطبخ"><div class="ph-foot"><span>صورة السكن</span><button type="button">إزالة</button></div></figure></div>
      <div class="drop"><svg class="ic ic-lg" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 18a5 5 0 0 1-.5-10A6 6 0 0 1 18 9a4 4 0 0 1 0 9"/><path d="M12 12v8M9 15l3-3 3 3"/></svg><strong>أضف صورًا أخرى للسكن</strong><p>صور بصيغة جي بي جي أو بي إن جي · حتى ٥ ميغابايت للصورة</p>
        <label class="btn btn-outline" style="cursor:pointer"><svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg> اختيار الصور<input id="photo-input" name="images" type="file" accept="image/jpeg,image/png" multiple hidden></label></div>
      <p class="muted" style="font-size:10px;margin:14px 0 0">استخدم صورًا حقيقية وحديثة، دون علامات مائية أو أرقام هاتف. ستكون الصورة الأولى هي غلاف إعلانك.</p></section><section class="panel"><h2>مراجعة وإرسال</h2><p class="sub" style="margin-bottom:16px"></p>
      <div class="check-list" style="gap:14px;margin-bottom:18px"><label class="chk"><input type="checkbox" required checked><span>أقرّ بأنني المالك أو المفوَّض بالتأجير وأن جميع البيانات والصور صحيحة.</span></label>
      <label class="chk"><input type="checkbox" required checked><span>أوافق على شروط نشر الإعلانات وسياسة الخصوصية في dar.</span></label></div>
      <div class="form-actions"><button class="btn btn-primary" type="submit">حفظ وإرسال التعديلات <svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m21 3-9 18-2-8-8-2z"/><path d="M21 3 10 13"/></svg></button><button class="btn btn-outline" type="submit" data-skip-validation>حفظ كمسودة</button><span class="spacer">آخر تحديث: ٦ تشرين الثاني ٢٠٢٦</span></div></section></form></div></div>
  </main>
  
