@{
    ViewData["Title"] = "إنشاء حساب | DAR";
    ViewData["BodyClass"] = "auth-page register-page";
    ViewData["FooterClass"] = "auth-footer";
}

  <main class="auth-main container">
    <section class="auth-form-panel">
      <a class="back-link" href="@Url.Action("Index", "Home")#listings"><span aria-hidden="true">→</span> العودة للبحث عن سكن</a>
      <h1>ابدأ رحلتك مع <span class="latin">دار</span></h1>
      <p class="auth-subtitle">حساب واحد يقرّبك من سكنك المناسب. احفظ المفضلة وتواصل مع أصحاب السكن بسهولة.</p>
      <form class="auth-form" id="register-form" novalidate>
        <fieldset class="role-picker"><legend>أريد التسجيل كـ</legend>
          <label class="role-option"><input type="radio" name="role" value="tenant" checked><span>مستأجر<small>أبحث عن سكن</small></span></label>
          <label class="role-option"><input type="radio" name="role" value="owner"><span>مالك<small>أعرض سكنًا للإيجار</small></span></label></fieldset>
        <div class="form-field"><label for="full-name">الاسم الكامل</label><div class="input-wrap"><input id="full-name" name="fullName" type="text" placeholder="اكتب اسمك الكامل" autocomplete="name" required><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span></div><small class="field-error"></small></div>
        <div class="form-field"><label for="register-email">البريد الإلكتروني</label><div class="input-wrap"><input id="register-email" name="email" type="email" placeholder="بريدك الجامعي أو الشخصي" autocomplete="email" required><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></span></div><small class="field-error"></small></div>
        <div class="form-field"><label for="phone">رقم الهاتف</label><div class="input-wrap"><input id="phone" name="phone" type="tel" placeholder="رقم هاتفك" autocomplete="tel" inputmode="tel" required><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6.6 3h3l1.4 4-2 1.5a15 15 0 0 0 6.5 6.5l1.5-2 4 1.4v3c0 1.1-.9 2-2 2C10 19.4 4.6 14 4.6 5c0-1.1.9-2 2-2z"/></svg></span></div><small class="field-error"></small></div>
        <div class="role-fields" id="tenant-fields"><div class="form-field"><label for="university">الجامعة</label><div class="input-wrap"><select id="university" name="university_id" ><option value="">اختر جامعتك</option><option value="1">الجامعة الأردنية</option><option value="2">جامعة العلوم التطبيقية</option><option value="3">جامعة الأميرة سمية</option><option value="4">جامعة أخرى</option></select><span class="input-icon select-icon" aria-hidden="true">⌄</span></div><small class="field-error"></small></div><div class="form-field"><label for="faculty">التخصص</label><div class="input-wrap"><input id="faculty" name="faculty" type="text" placeholder="مثال: الهندسة المدنية" ></div><small class="field-error"></small></div><div class="form-row"><div class="form-field"><label for="tenant-gender">الجنس</label><div class="input-wrap"><select id="tenant-gender" name="gender" ><option value="">اختر</option><option value="male">ذكر</option><option value="female">أنثى</option></select><span class="input-icon select-icon" aria-hidden="true">⌄</span></div><small class="field-error"></small></div><div class="form-field"><label for="nationality">الجنسية</label><div class="input-wrap"><input id="nationality" name="nationality" type="text" placeholder="مثال: أردني" ></div><small class="field-error"></small></div></div><div class="form-field"><label for="date-of-birth">تاريخ الميلاد</label><div class="input-wrap"><input id="date-of-birth" name="date_of_birth" type="date" placeholder="" ></div><small class="field-error"></small></div></div>
        <div class="role-fields" id="owner-fields" hidden><div class="form-field"><label for="owner-gender">الجنس</label><div class="input-wrap"><select id="owner-gender" name="gender" disabled><option value="">اختر</option><option value="male">ذكر</option><option value="female">أنثى</option></select><span class="input-icon select-icon" aria-hidden="true">⌄</span></div><small class="field-error"></small></div><div class="form-field"><label for="whatsapp">رقم واتساب</label><div class="input-wrap"><input id="whatsapp" name="whatsapp" type="tel" placeholder="رقم واتساب للتواصل مع الطلاب" inputmode="tel" disabled></div><small class="field-error"></small></div><div class="form-field"><label for="about">نبذة عنك (اختياري)</label><textarea id="about" name="about" maxlength="1000" placeholder="عرّف الطلاب بنفسك وبطريقة تعاملك..." disabled></textarea><small class="field-error"></small></div></div>
        <div class="form-field"><label for="register-password">كلمة المرور</label><div class="input-wrap"><input id="register-password" name="password" type="password" placeholder="أنشئ كلمة مرور" autocomplete="new-password" minlength="8" required><button class="input-icon password-toggle" type="button" aria-label="إظهار كلمة المرور" data-target="register-password"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button></div><small class="field-hint">٨ أحرف على الأقل، تتضمن حرفًا ورقمًا.</small><small class="field-error"></small></div>
        <div class="form-field"><label for="confirm-password">تأكيد كلمة المرور</label><div class="input-wrap"><input id="confirm-password" name="confirmPassword" type="password" placeholder="أعد كتابة كلمة المرور" autocomplete="new-password" required><button class="input-icon password-toggle" type="button" aria-label="إظهار كلمة المرور" data-target="confirm-password"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button></div><small class="field-error"></small></div>
        <label class="check-line"><input id="terms-check" type="checkbox" required><span>أوافق على <a href="#footer">الشروط والأحكام</a> و<a href="#footer">سياسة الخصوصية</a> الخاصة بمنصة دار.</span></label>
        <small class="form-general-error" id="register-general-error" aria-live="polite"></small>
        <button class="btn btn-primary btn-block" type="submit">إنشاء حساب</button>
        <div class="or-divider"><span>أو</span></div>
        <button class="btn btn-google btn-block" type="button" data-demo="google"><span class="google-symbol" aria-hidden="true">◎</span> المتابعة باستخدام جوجل</button>
        <p class="auth-switch">لديك حساب بالفعل؟ <a href="@Url.Action("Login", "Account")">تسجيل الدخول</a></p>
      </form>
    </section>
    <aside class="auth-promo-register"><img src="~/assets/auth-building.jpg" alt="مبنى سكني قريب من الجامعة مع عبارة سكنك أقرب وحياتك الجامعية أسهل"></aside>
  </main>
  
