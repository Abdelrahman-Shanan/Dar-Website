@{
    ViewData["Title"] = "نسيت كلمة المرور | DAR";
    ViewData["BodyClass"] = "auth-page login-page";
    ViewData["FooterClass"] = "auth-footer";
}

  <main class="auth-main container login-main">
    <section class="auth-form-panel login-form-panel">
      <a class="back-link" href="@Url.Action("Login", "Account")"><span aria-hidden="true">→</span> العودة لتسجيل الدخول</a>
      <h1>نسيت كلمة المرور</h1>
      <p class="auth-subtitle">أدخل البريد الإلكتروني المرتبط بحسابك، وسنرسل لك رابطًا لتعيين كلمة مرور جديدة.</p>
      <form class="auth-form login-form" id="forgot-form" novalidate>
        <div class="form-field"><label for="forgot-email">البريد الإلكتروني</label><div class="input-wrap"><input id="forgot-email" name="email" type="email" placeholder="بريدك الجامعي أو الشخصي" autocomplete="email" required><span class="input-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg></span></div><small class="field-error"></small></div>
        <small class="form-general-error" id="forgot-general" aria-live="polite"></small>
        <button class="btn btn-primary btn-block" type="submit">إرسال رابط الاستعادة</button>
        <p class="auth-switch" id="forgot-sent" hidden>تم الإرسال إن كان البريد مسجلًا لدينا. <a href="@Url.Action("ResetPassword", "Account")">فتح صفحة التعيين (للتجربة)</a></p>
        <p class="privacy-note"><span aria-hidden="true">♙</span> بياناتك آمنة، ولا نشاركها دون موافقتك.</p>
      </form>
    </section>
    <aside class="auth-promo-login"><img src="~/assets/auth-building-login.jpg" alt="مبنى سكني قريب من الجامعة وقت المساء"></aside>
  </main>
  
