          <div class="f"><label for="start_date">موعد الانتقال المتوقع</label><div class="with-icon"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/></svg><input id="start_date" name="start_date" type="date" required></div><span class="err">اختر موعد الانتقال.</span></div>
