@{
    ViewData["Title"] = "البحث عن سكن | DAR";
    ViewData["Nav"] = "search";
    ViewData["Description"] = "ابحث عن سكن طلابي بالقرب من جامعتك.";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages.css" />
}
@section Scripts {
    <script src="~/js/pages.js" defer></script>
}

  <main>
    <section class="search-hero"><div class="container">
      <ol class="crumbs" aria-label="مسار التنقل"><li><a href="@Url.Action("Index", "Home")">الرئيسية</a></li><li><a href="@Url.Action("Search", "Properties")">ابحث عن سكن</a></li><li>عمّان</li></ol>
      <form class="big-search" id="hero-search" role="search">
        <div class="grow"><span class="pin"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6 7-12a7 7 0 0 0-14 0c0 6 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg></span><input id="hero-q" type="text" value="عمّان، بالقرب من الجامعة الأردنية" aria-label="ابحث عن موقع أو جامعة"><button class="clear" type="button" aria-label="مسح البحث"><svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div>
        <button class="btn btn-primary" type="submit"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg> بحث</button>
      </form></div></section>
    <div class="container search-layout">
      <aside><form class="filters" id="filters" aria-label="تصفية النتائج">
        <h2><span>حدّد سكنك</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg></h2>
        <div class="fgroup"><h3>الموقع والجامعة</h3>
          <div class="f"><label for="city">المدينة</label><select id="city"><option>عمّان</option><option>إربد</option><option>الزرقاء</option></select></div>
          <div class="f"><label for="uni">بالقرب من</label><select id="uni"><option value="ju">الجامعة الأردنية</option><option value="all">كل الجامعات</option><option value="htu">جامعة العلوم التطبيقية</option></select></div>
          <div class="f"><label for="dist">المسافة من الجامعة</label><select id="dist"><option value="0">أي مسافة</option><option value="10">حتى ١٠ دقائق</option><option value="20">حتى ٢٠ دقيقة</option><option value="30" selected>حتى ٣٠ دقيقة</option></select></div></div>
        <div class="fgroup"><h3>نوع السكن</h3><label class="chk"><input type="checkbox" name="type" value="apartment" checked><span>شقة كاملة</span></label><label class="chk"><input type="checkbox" name="type" value="studio" checked><span>استوديو</span></label><label class="chk"><input type="checkbox" name="type" value="private" checked><span>غرفة خاصة</span></label><label class="chk"><input type="checkbox" name="type" value="shared" checked><span>غرفة مشتركة</span></label></div>
        <div class="fgroup"><h3>الإيجار الشهري (د.أ)</h3>
          <div class="price-inputs"><div><label for="price-min">من</label><input id="price-min" type="number" value="80" min="50" max="350" inputmode="numeric"></div><div><label for="price-max">إلى</label><input id="price-max" type="number" value="300" min="50" max="350" inputmode="numeric"></div></div>
          <div class="range" dir="ltr"><span class="track-bg"></span><span class="fill"></span><input id="price-min-range" type="range" min="50" max="350" step="5" value="80" aria-label="الحد الأدنى للإيجار"><input id="price-max-range" type="range" min="50" max="350" step="5" value="300" aria-label="الحد الأعلى للإيجار"></div></div>
        <div class="fgroup"><h3>تفاصيل تهمّك</h3><label class="chk"><input type="checkbox" name="flag" value="furnished" checked><span>مفروش بالكامل</span></label><label class="chk"><input type="checkbox" name="flag" value="internet"><span>إنترنت متوفر</span></label><label class="chk"><input type="checkbox" name="flag" value="bills"><span>الفواتير مشمولة</span></label><label class="chk"><input type="checkbox" name="flag" value="female"><span>مناسب للطالبات</span></label><label class="chk"><input type="checkbox" name="flag" value="male"><span>مناسب للطلاب</span></label></div>
        <button class="btn btn-primary btn-block" type="button" id="show-results">عرض <span data-result-count>٦</span> نتيجة</button>
        <button class="reset-link" type="button" id="reset-filters">إعادة ضبط الفلاتر</button>
