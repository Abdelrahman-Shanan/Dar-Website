@{
    ViewData["Title"] = "لوحة التحكم | DAR";
    ViewData["UserName"] = "ليلى منصور";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages.css" />
}
@section Scripts {
    <script src="~/js/pages.js" defer></script>
}

  <main class="container page">
    <ol class="crumbs" aria-label="مسار التنقل"><li><a href="@Url.Action("Index", "Home")">الرئيسية</a></li><li><a href="@Url.Action("Dashboard", "Admin")">إدارة المنصة</a></li><li>لوحة التحكم</li></ol>
    <div class="page-head"><div><h1>لوحة التحكم</h1><p class="sub">أهلًا ليلى، إليك نظرة على نشاط dar والمهام التي تحتاج انتباهك اليوم.</p></div><div class="head-side"><button class="btn btn-outline" type="button" data-toast="تغيير الفترة الزمنية يحتاج إلى بيانات حقيقية من Backend."><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/></svg> آخر ٣٠ يومًا</button></div></div>
    <div class="dash"><aside class="side" aria-label="قائمة الحساب"><div class="side-user"><span class="avatar"><svg class="ic ic-lg" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v6c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V6z"/><path d="m9 12 2 2 4-4"/></svg></span><strong>ليلى منصور</strong><span>إدارة المنصة</span></div><nav class="side-nav"><a href="@Url.Action("Dashboard", "Admin")" class="active" aria-current="page"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1"/><rect x="13" y="4" width="7" height="5" rx="1"/><rect x="13" y="12" width="7" height="8" rx="1"/><rect x="4" y="14" width="7" height="6" rx="1"/></svg><span>لوحة التحكم</span></a><a href="@Url.Action("Listings", "Admin")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h4"/></svg><span>مراجعة الشقق المعلقة</span><span class="count">١٢</span></a><a href="@Url.Action("Users", "Admin")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2.5.8 4 3 4 6"/></svg><span>إدارة المستخدمين</span></a><a href="@Url.Action("Reviews", "Admin")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.5 7.2L4 20l1-4A8 8 0 1 1 20 12z"/></svg><span>إدارة التقييمات</span><span class="count">٥</span></a></nav><a class="side-logout" href="@Url.Action("Login", "Account")"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4"/><path d="m16 8 4 4-4 4M20 12H9"/></svg><span>تسجيل الخروج</span></a><div class="side-help"><strong>تحتاج مساعدة؟</strong><p>فريق dar معك في كل خطوة.</p><a href="#footer">تواصل مع الدعم ←</a></div></aside><div class="dash-main">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:14px"><span class="badge b-ok">المنصة تعمل بشكل طبيعي</span><span class="muted" style="font-size:11px">آخر تحديث: ٧ تشرين الثاني ٢٠٢٦، ١٠:٣٠ ص</span></div>
      <div class="stats"><div class="stat"><div class="stat-top"><span>المستخدمون</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2.5.8 4 3 4 6"/></svg></div><div class="stat-num">١٬٢٤٨</div><p class="stat-hint">٨٤ حسابًا جديدًا هذا الشهر</p></div><div class="stat"><div class="stat-top"><span>الشقق المنشورة</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="1"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"/></svg></div><div class="stat-num">٨٦</div><p class="stat-hint">١٨ إعلانًا جديدًا هذا الشهر</p></div><div class="stat"><div class="stat-top"><span>شقق بانتظار المراجعة</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div><div class="stat-num">١٢</div><p class="stat-hint">٤ إعلانات أضيفت اليوم</p></div><div class="stat"><div class="stat-top"><span>تقييمات مبلّغ عنها</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg></div><div class="stat-num">٥</div><p class="stat-hint">بحاجة إلى مراجعة المحتوى</p></div></div>
      <h2 class="section-title" style="margin-top:6px">أقسام الإدارة</h2><div class="mgmt"><div class="panel"><span class="avatar"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4h6v3H9zM9 12h6M9 16h4"/></svg></span><h3>مراجعة الشقق المعلقة</h3><div class="num">١٢ إعلانًا</div><p>تحقق من بيانات السكن والصور قبل اعتماد النشر.</p><a class="btn btn-outline btn-sm" href="@Url.Action("Listings", "Admin")">مراجعة الإعلانات <svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a></div><div class="panel"><span class="avatar"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2 20a7 7 0 0 1 14 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14c2.5.8 4 3 4 6"/></svg></span><h3>إدارة المستخدمين</h3><div class="num">٣ طلبات توثيق</div><p>راجع حسابات الملاك وتابع الحسابات الموقوفة.</p><a class="btn btn-outline btn-sm" href="@Url.Action("Users", "Admin")">إدارة الحسابات <svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a></div><div class="panel"><span class="avatar"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 0 1-11.5 7.2L4 20l1-4A8 8 0 1 1 20 12z"/></svg></span><h3>إدارة التقييمات</h3><div class="num">٥ بلاغات جديدة</div><p>راجع المحتوى المبلّغ عنه واحذف المخالفات.</p><a class="btn btn-outline btn-sm" href="@Url.Action("Reviews", "Admin")">مراجعة التقييمات <svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></a></div></div>
      <div class="dash-cols">
        <div>
          <div class="panel"><h2>الشقق بانتظار المراجعة</h2><p class="sub">ابدأ بالإعلانات الأقدم لضمان سرعة النشر.</p><div class="mini"><img src="~/assets/p-studio.jpg" alt=""><div><strong>استوديو هادئ وجاهز للسكن</strong><span>أحمد الخطيب · ضاحية الرشيد</span></div><a class="btn btn-outline btn-sm" href="@Url.Action("Listings", "Admin")">مراجعة</a></div><div class="mini"><img src="~/assets/p-balcony.jpg" alt=""><div><strong>شقة مفروشة مع شرفة</strong><span>محمود الرواشدة · شارع ياجوز</span></div><a class="btn btn-outline btn-sm" href="@Url.Action("Listings", "Admin")">مراجعة</a></div><div class="mini"><img src="~/assets/p-shared.jpg" alt=""><div><strong>غرفة مشتركة قريبة من كل شيء</strong><span>هناء العلي · الجبيهة</span></div><a class="btn btn-outline btn-sm" href="@Url.Action("Listings", "Admin")">مراجعة</a></div><a class="mini-more" href="@Url.Action("Listings", "Admin")"><svg class="ic ic-sm" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg> عرض جميع الإعلانات المعلقة (١٢)</a></div>
          <div class="panel" style="margin-bottom:0"><h2>طلبات الإيجار خلال الأسبوع</h2><p class="sub">٥٥ طلبًا جديدًا · من ١ إلى ٧ تشرين الثاني</p><div class="bars" role="img" aria-label="رسم بياني لطلبات الإيجار اليومية"><div class="bar"><b>٤</b><i style="height:33%"></i><span>الأحد</span></div><div class="bar"><b>٧</b><i style="height:58%"></i><span>الاثنين</span></div><div class="bar"><b>٥</b><i style="height:42%"></i><span>الثلاثاء</span></div><div class="bar"><b>٩</b><i style="height:75%"></i><span>الأربعاء</span></div><div class="bar"><b>٨</b><i style="height:67%"></i><span>الخميس</span></div><div class="bar"><b>١٢</b><i style="height:100%"></i><span>الجمعة</span></div><div class="bar"><b>١٠</b><i style="height:83%"></i><span>السبت</span></div></div></div>
        </div>
        <div>
          <div class="panel" style="margin-bottom:0"><h2>حسابات المنصة</h2><div style="margin-top:14px"><div class="acc-row"><span>مستأجرون</span><b>١٬٠٨٤</b></div><div class="acc-row"><span>ملاك</span><b>١٦٠</b></div><div class="acc-row"><span>مديرو المنصة</span><b>٤</b></div></div>
            <p class="acc-note">٣ حسابات ملاك تنتظر التوثيق.</p><a class="btn btn-outline btn-sm" href="@Url.Action("Users", "Admin")">مراجعة طلبات التوثيق</a></div>
        </div>
      </div>
    </div></div>
  </main>
  
