@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة | DAR";
    ViewData["BodyClass"] = "auth-page login-page";
    ViewData["FooterClass"] = "auth-footer";
}

  <main class="auth-main container login-main">
    <section class="auth-form-panel login-form-panel">
      <a class="back-link" href="@Url.Action("Login", "Account")"><span aria-hidden="true">→</span> العودة لتسجيل الدخول</a>
      <h1>تعيين كلمة مرور جديدة</h1>
      <p class="auth-subtitle">وصلت إلى هنا عبر رابط الاستعادة المرسل إلى بريدك الإلكتروني. اختر كلمة مرور جديدة لحسابك.</p>
      <form class="auth-form login-form" id="reset-form" novalidate>
        <div class="form-field"><label for="new-password">كلمة المرور الجديدة</label><div class="input-wrap"><input id="new-password" name="password" type="password" placeholder="أدخل كلمة المرور الجديدة" autocomplete="new-password" required><button class="input-icon password-toggle" type="button" aria-label="إظهار كلمة المرور" data-target="new-password"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button></div><span class="field-hint">٨ أحرف على الأقل، تتضمن حرفًا ورقمًا.</span><small class="field-error"></small></div>
        <div class="form-field"><label for="confirm-new-password">تأكيد كلمة المرور</label><div class="input-wrap"><input id="confirm-new-password" name="confirm" type="password" placeholder="أعد كتابة كلمة المرور الجديدة" autocomplete="new-password" required><button class="input-icon password-toggle" type="button" aria-label="إظهار كلمة المرور" data-target="confirm-new-password"><svg viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button></div><small class="field-error"></small></div>
        <small class="form-general-error" id="reset-general" aria-live="polite"></small>
        <button class="btn btn-primary btn-block" type="submit">حفظ كلمة المرور الجديدة</button>
        <p class="privacy-note"><span aria-hidden="true">♙</span> بياناتك آمنة، ولا نشاركها دون موافقتك.</p>
      </form>
    </section>
    <aside class="auth-promo-login"><img src="~/assets/auth-building-login.jpg" alt="مبنى سكني قريب من الجامعة وقت المساء"></aside>
  </main>
  
