    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- سكربت قاعدة البيانات يبقى ضمن المشروع للرجوع إليه فقط ولا يُنشر -->
    <None Include="Database\**" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
